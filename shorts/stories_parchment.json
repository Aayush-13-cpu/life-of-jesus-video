    {"say": "Father, if thou be willing, remove this cup from me: nevertheless not my will, but thine, be done.", "sky": "night", "ground": "garden", "fx": ["rays"],
     "cast": [{"k": "jesus", "x": 600, "s": 1.6, "acts": [{"do": "kneel"}, {"do": "lower", "at": 2.6}]}]},
    {"say": "He was honest about his anguish, and still surrendered. You can pray both, too: what you want, and thy will be done.", "sky": "dawn", "ground": "garden",
     "cast": [{"k": "tree", "x": 250, "s": 1.0}, {"k": "jesus", "x": 600, "s": 1.6, "acts": [{"do": "kneel"}, {"do": "stand", "at": 1.6}]}]}]},
  {"id": "peter-denies", "style": "parchment", "genre": "passion", "title": "Before the Rooster Crowed", "ref": "Luke 22:61",
