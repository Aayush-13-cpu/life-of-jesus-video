     "cast": [{"k": "jesus", "x": 380, "s": 1.6, "acts": [{"do": "bless", "at": 0.6}]}, {"k": "woman", "x": 680, "s": 1.5, "flip": true, "acts": [{"do": "lower", "at": 2.4}]}]},
    {"say": "Mary hath chosen that good part. Busy is not the same as close. Sit with him before you serve him.", "sky": "dawn", "ground": "city", "fx": ["rays"],
