    {"say": "He lifted himself up: He that is without sin among you, let him first cast a stone at her. One by one, they left.", "sky": "dusk", "ground": "city",
     "cast": [{"k": "jesus", "x": 400, "s": 1.6, "acts": [{"do": "bless", "at": 0.6}]}, {"k": "crowd", "x": 860, "y": 1385, "s": 0.95, "n": 6, "acts": [{"do": "walk", "to": 1500, "at": 3.0, "dur": 3}]}]},
    {"say": "Neither do I condemn thee: go, and sin no more. Grace first, then a new way to live.", "sky": "dawn", "ground": "city", "fx": ["rays"],
     "cast": [{"k": "woman", "x": 600, "s": 1.5, "acts": [{"do": "kneel"}, {"do": "stand", "at": 1.6}]}, {"k": "jesus", "x": 380, "s": 1.6, "acts": [{"do": "reach", "at": 0.6}]}]}]},
  {"id": "gethsemane", "style": "parchment", "genre": "passion", "title": "The Garden of Gethsemane", "ref": "Luke 22:42",
   "beats": [
    {"say": "The night before the cross, Jesus went into a garden of olive trees to pray. His friends fell asleep.", "sky": "night", "ground": "garden",
