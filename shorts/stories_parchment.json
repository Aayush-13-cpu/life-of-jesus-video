    {"say": "And Peter went out, and wept bitterly. That look was not the end of Peter. It was the beginning of his restoration.", "sky": "dawn", "ground": "hills",
     "cast": [{"k": "man", "x": 540, "s": 1.55, "acts": [{"do": "kneel", "at": 0.6}]}]}]},
