  {"id": "first-stone", "style": "parchment", "genre": "encounter", "title": "Cast the First Stone", "ref": "John 8:7",
   "beats": [
    {"say": "They dragged a woman before Jesus, caught in adultery, and demanded: Moses said stone her. What sayest thou?", "sky": "day", "ground": "city",
